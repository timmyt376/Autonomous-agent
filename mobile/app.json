{
  "expo": {
    "name": "ACI Mobile",
    "slug": "aci-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "dev.aci.mobile",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "dev.aci.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "./plugins/withOpenCLNativeLibrary",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ACI uses selected photos only when you choose to attach or inspect them.",
          "cameraPermission": "ACI uses the camera only when you choose to take a photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
