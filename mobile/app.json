{
  "expo": {
    "name": "ACI Mobile",
    "slug": "aci-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "dev.aci.mobile",
      "permissions": ["INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "dev.aci.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCL": true
        }
      ]
    ]
  }
}
