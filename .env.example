# Active desktop/server inference provider: ollama, deepseek or openai-compatible
ACI_PROVIDER=ollama

# Local Ollama runtime
ACI_OLLAMA_URL=http://127.0.0.1:11434
ACI_MODEL=llama3.2:3b

# DeepSeek hosted API. Keep the key out of source control.
# You can also save it through the desktop UI into the operating-system keyring.
DEEPSEEK_API_KEY=
ACI_DEEPSEEK_BASE_URL=https://api.deepseek.com
ACI_DEEPSEEK_MODEL=deepseek-flash

# Optional custom OpenAI-compatible endpoint
ACI_OPENAI_BASE_URL=
ACI_OPENAI_MODEL=
ACI_OPENAI_API_KEY=

# Optional local ComfyUI image-generation server
ACI_COMFYUI_URL=http://127.0.0.1:8188

ACI_DATA_DIR=./data
ACI_WORKSPACE=./workspace
ACI_HOST=127.0.0.1
ACI_PORT=8765
ACI_MAX_CONTEXT_MESSAGES=12

# Optional bearer token required by all /api/* endpoints when set
ACI_API_TOKEN=
